server:
  port: 8082

spring:
  application:
    name: users-service

  datasource:
    url: jdbc:mysql://localhost:3306/users_service?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
    username: root
    password: kondi123
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/
  instance:
    prefer-ip-address: true

feign:
  client:
    config:
      default:
        connectTimeout: 5000
        readTimeout: 5000
        loggerLevel: basic

logging:
  level:
    com.fakultet.usersservice.client: DEBUG
